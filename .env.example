# Optional: writable directory for local project state and hashed agent credentials.
# Default when unset: <application working directory>/.agentcloud
# Keep the same directory across restarts. Do not commit its contents.
# AGENTCLOUD_DATA_DIR=/absolute/path/to/agentcloud-data

# CLI-only variables: export in the invoking shell; the CLI does not load .env.local.
# Default API URL is http://127.0.0.1:3000. Nonlocal URLs require HTTPS.
# AGENTCLOUD_URL=http://127.0.0.1:3000
# Read AGENTCLOUD_TOKEN interactively as described in README.md.
# Never commit or paste a real token into this example file.
