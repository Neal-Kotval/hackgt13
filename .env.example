# Optional: writable directory for local project state and hashed agent credentials.
# Default when unset: <application working directory>/.agentcloud
# Keep the same directory across restarts. Do not commit its contents.
# AGENTCLOUD_DATA_DIR=/absolute/path/to/agentcloud-data

# CLI-only variables: export in the invoking shell; the CLI does not load .env.local.
# Default API URL is http://127.0.0.1:3000. Nonlocal URLs require HTTPS.
# AGENTCLOUD_URL=http://127.0.0.1:3000
# Read AGENTCLOUD_TOKEN interactively as described in README.md.
# Never commit or paste a real token into this example file.

# Employee auth: auth:setup generates BETTER_AUTH_SECRET in .env.local.
# Preserve the secret and auth.sqlite across restarts. Never commit either.
# BETTER_AUTH_URL=http://127.0.0.1:3000
# Bootstrap employee email/password variables are supplied interactively; see README.
# Platform AWS approvals require a verified operator account; keep this server-side.
# AGENTCLOUD_PLATFORM_ADMIN_EMAIL=operator@example.com

# Email defaults to private local capture; no actual inbox delivery.
# AGENTCLOUD_MAIL_MODE=local
# For SMTP, set AGENTCLOUD_MAIL_MODE=smtp and your provider settings privately.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=AgentCloud <noreply@example.com>
# SMTP_USER=
# SMTP_PASSWORD=
